<?php
$conn = mysqli_connect("localhost", "root", "", "sipeduli_db");

if (isset($_POST['submit'])) {
    $nama = $_POST['nama'];
    $email = $_POST['email'];
    $kategori = $_POST['kategori'];
    $jenis = $_POST['jenis_donasi'];
    $tanggal = date('Y-m-d H:i:s');

    // Proses upload bukti transfer
    $bukti_transfer = '';
    if ($_FILES['bukti_transfer']['name'] != '') {
        $bukti_transfer = $_FILES['bukti_transfer']['name'];
        $tmp = $_FILES['bukti_transfer']['tmp_name'];
        move_uploaded_file($tmp, 'uploads/' . $bukti_transfer);
    }

    // Proses upload bukti barang
    $bukti_barang = '';
    if ($_FILES['bukti_barang']['name'] != '') {
        $bukti_barang = $_FILES['bukti_barang']['name'];
        $tmp2 = $_FILES['bukti_barang']['tmp_name'];
        move_uploaded_file($tmp2, 'uploads/' . $bukti_barang);
    }

    // Simpan ke database
    $query = "INSERT INTO donatur (nama, email, kategori, jenis_donasi, bukti_transfer, bukti_barang, tanggal_donasi)
              VALUES ('$nama', '$email', '$kategori', '$jenis', '$bukti_transfer', '$bukti_barang', '$tanggal')";

    if (mysqli_query($conn, $query)) {
        echo "<script>alert('Data berhasil ditambahkan!'); window.location.href='dashboard2.php';</script>";
    } else {
        echo "Gagal menyimpan data: " . mysqli_error($conn);
    }
}
